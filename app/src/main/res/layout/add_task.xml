<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etProduktname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Produktname" />

        <EditText
            android:id="@+id/ettitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Titel" />




        <EditText
            android:id="@+id/etBeschreibung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Beschreibung" />

        <EditText
            android:id="@+id/etduedate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fälligkeitsdatum" />

        <EditText
            android:id="@+id/etpriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Priorität" />

        <Spinner
            android:id="@+id/spDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etdone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Erledigt (true/false)" />



        <Button
            android:id="@+id/btnSpeichern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Speichern" />

        <Button
            android:id="@+id/btnAbbrechen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abbrechen" />

        <Button
            android:id="@+id/btnLöschen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Löschen" />

    </LinearLayout>
</ScrollView>